#!/bin/sh
# The two tools this tutorial runs, pinned. Each is downloaded once into
# .roux-tools/, checked against its sha256, then unpacked.
#
#   ./roux dev main.roc        roux: the dev server (and `build`)
#   ./roux roc test main.roc   roc: the Roc compiler roux uses
set -eu

roux=roux-0.5.1
roux_url=https://github.com/Eldhus/roux/releases/download/v0.5.1/roux-0.5.1-x86_64-linux.tar.gz
roux_sha256=19c2b763fcad2ddb063495dbe899b2e9b6ccdcee00b24878036bdc977ca151b1

roc=roc-nightly-2026-10-24-f6c6cfb
roc_url=https://github.com/roc-lang/nightlies/releases/download/nightly-2026-10-24-f6c6cfb/roc_nightly-linux_x86_64-2026-10-24-f6c6cfb.tar.gz
roc_sha256=86963a4f5ebbe63f5a017662c602e89468c1b8a5d08f69da45c088d3006754ba

tools=$(cd "$(dirname "$0")" && pwd)/.roux-tools

# fetch NAME URL SHA256 STRIP: download, check, unpack into $tools/NAME.
# STRIP is how many leading directories the archive's paths have. Then
# the tool's other versions there (roux-*, roc-*), an older pin's, go.
fetch() {
	[ -d "$tools/$1" ] && return
	echo "roux: fetching $1 (once)" >&2
	mkdir -p "$tools"
	curl -fL --progress-bar "$2" -o "$tools/$1.tar.gz"
	if ! echo "$3  $tools/$1.tar.gz" | sha256sum -c --quiet; then
		echo "roux: $1's download does not match its checksum; removed" >&2
		rm -f "$tools/$1.tar.gz"
		exit 1
	fi
	mkdir -p "$tools/$1.unpacking"
	tar -xzf "$tools/$1.tar.gz" -C "$tools/$1.unpacking" --strip-components="$4"
	mv "$tools/$1.unpacking" "$tools/$1"
	rm "$tools/$1.tar.gz"
	for old in "$tools/${1%%-*}"-*; do
		[ "$old" = "$tools/$1" ] || rm -rf "$old"
	done
}

if [ "$(uname -sm)" != "Linux x86_64" ]; then
	echo "roux runs on Linux x86-64; this is $(uname -sm)." >&2
	exit 1
fi
fetch "$roux" "$roux_url" "$roux_sha256" 0
fetch "$roc" "$roc_url" "$roc_sha256" 1

# roux runs the `roc` on PATH: this one.
PATH=$tools/$roc:$PATH
export PATH
if [ "${1:-}" = roc ]; then
	shift
	exec roc "$@"
fi
exec "$tools/$roux/roux" "$@"
